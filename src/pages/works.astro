---
import { getCollection } from "astro:content";
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
const allProjects = await getCollection("projects");
const pageTitle = "Works — Jacobyne Tambe";
const description = "Data analysis projects by Jacobyne Tambe, exploring entertainment trends, APIs, and Python-powered visualizations.";
---
<Layout pageTitle={pageTitle} description={description}>
    <div class="gif">
        <img src="/images/laptop.webp" role="presentation" width="300" height="259" decoding="async">
    </div>
    <h2>Projects</h2>
    <ul role="list" class="link-card-grid">
        {allProjects.map((card) => <Card
            url={`/projects/${card.id}/`}
            image={card.data.image.url}
            title={card.data.title}
            body={card.data.description}
        />)}
        <li class="card coming-soon-card">
            <div class="coming-soon-inner">
                <span class="badge coming-soon-badge">Coming Soon</span>
                <h3 class="card__title">SQL Project</h3>
                <p class="card__txt">A data analysis project using SQL to explore and surface insights from structured datasets.</p>
            </div>
        </li>
        <li class="card coming-soon-card">
            <div class="coming-soon-inner">
                <span class="badge coming-soon-badge">Coming Soon</span>
                <h3 class="card__title">Capstone Project</h3>
                <p class="card__txt">A comprehensive end-to-end data analysis project combining multiple tools and techniques.</p>
            </div>
        </li>
        <li class="card coming-soon-card">
            <div class="coming-soon-inner">
                <span class="badge coming-soon-badge">Coming Soon</span>
                <h3 class="card__title">Excel Project</h3>
                <p class="card__txt">A data analysis and visualization project built with Excel, including dashboards and formulas.</p>
            </div>
        </li>
    </ul>
</Layout>
