---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Card from '../components/Card.astro';
const pageTitle = "Jacobyne Tambe — Data Analyst";
const description = "Data analyst specializing in Python, APIs, and data visualization. Passionate about entertainment data, storytelling, and uncovering insights that matter.";
const allProjects = await getCollection("projects");
---
<Layout pageTitle={pageTitle} description={description}>
    <div class="gif">
        <img src="/images/space.webp" role="presentation" width="300" height="259" decoding="async">
    </div>
    <h1>Jacobyne Tambe</h1>
    <span class="badge">Data Analyst</span>

    <h2>About Me</h2>
    <div class="about">
        <!-- Replace /images/headshot.jpg with your actual headshot photo -->
        <img class="headshot" src="/images/headshot.jpg" alt="Jacobyne Tambe" width="140" height="140" onerror="this.style.display='none'">
        <p>
        I'm a data analyst who believes data tells stories. I specialize in Python, APIs, and data visualization. I love uncovering patterns in datasets and transforming them into insights that actually mean something.
        My perfect project? One where I get to dive deep into research (yes, I'm that person with 50 browser tabs open), discover surprising patterns, create beautiful visualizations, and share what I learned. Bonus points if it involves entertainment data: TV shows, music, games, or anything that explores why audiences love what they love.
        I am interested in pursuing opportunities that combine analytical rigor with creative curiosity.
        </p>
    </div>

    <h2>Skills</h2>
    <div class="skills center">
        <p>
        Python • Data Analysis • Pandas • APIs • Data Visualization • SQL • Excel • Agile • Process Improvement
        </p>
    </div>

    <h2>Projects</h2>
    <ul role="list" class="link-card-grid">
        {allProjects.map((card) => (
            <Card
                url={`/projects/${card.id}/`}
                image={card.data.image.url}
                title={card.data.title}
                body={card.data.description}
            />
        ))}
    </ul>
    <div class="center">
        <a href="/works/">
            <button class="btn">View all projects</button>
        </a>
    </div>

    <h2>Interests</h2>
    <p>
<strong>📚 Storytelling Enthusiast:</strong> I'm obsessed with captivating narratives whether it's through data visualizations or fiction novels. I am currently writing my first fantasy novel!
</p>
<p>
<strong>✍️ Lifestyle Blogger:</strong> I run a blog about working smarter where I explore productivity hacks, optimization strategies, and wellness.
</p>
<p>
<strong>🎬 Entertainment Data:</strong> I'm fascinated by what makes shows succeed, songs trend, and games captivate audiences. My portfolio projects explore these questions through data.
</p>
<p>
<strong>🧠 Perpetual Learner:</strong> I'm always learning something new. Currently: advanced Python visualization, web scraping, and building this portfolio with Astro!
</p>

    <h2>Contact</h2>
    <p>I'm open to data analyst opportunities and collaborations. Feel free to reach out!</p>
    <ul class="contact-list">
        <li>
            <span class="badge badge--item">LinkedIn</span>
            <a class="badge__link" href="https://www.linkedin.com/in/jacobyne-marie-tambe/" target="_blank">linkedin.com/in/jacobyne-marie-tambe</a>
        </li>
        <li>
            <span class="badge badge--item">Email</span>
            <a class="badge__link" href="mailto:marietambe07@gmail.com">marietambe07@gmail.com</a>
        </li>
    </ul>
</Layout>
