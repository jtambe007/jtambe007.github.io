---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Card from '../components/Card.astro';
const pageTitle = "Jacobyne Tambe — Rigorous data systems. Delivered without the drama.";
const description = "Jacobyne Tambe builds production-grade ML models, Streamlit apps, and data pipelines for agencies and SMBs. Currently at Bank of America. Based in Charlotte, NC.";
const allProjects = await getCollection("projects");
---
<Layout pageTitle={pageTitle} description={description}>

    <h1>Jacobyne Tambe</h1>
    <p class="hero__tagline">Rigorous data systems. Delivered without the drama.</p>
    <p class="hero__promise">I build production-grade data work for smaller companies.</p>
    <div class="hero__stack">Python · ML · Streamlit · ETL · NLP · Currently at Bank of America</div>
    <div class="center hero__cta">
        <a href="#contact">
            <button class="btn">Get in touch</button>
        </a>
    </div>
    <!-- Loom embed: replace href with your Loom URL when ready -->
    <!-- <p class="center"><a class="badge__link" href="https://loom.com/share/YOUR_ID">▶ Watch: 60-min CSV to Dashboard — how fast can I ship for your client?</a></p> -->

    <h2>About</h2>
    <p>Two-plus years at Bank of America, building production ML models, Streamlit apps, and data pipelines inside a regulated, enterprise environment. I learned what real production systems look like: governance, audit trails, documentation discipline, fallback paths. The kind of rigor that only gets beaten into you when something breaks and regulators notice.</p>
    <p>The culture didn't match the craft. Micromanagement, hostile team dynamics, the long slow grind that eats good builders. I watched myself start to burn out and made a decision: leave before the work I cared about became work I hated.</p>
    <p>Same rigor, without the rot. Freelance, async-first, no drama. I help agencies and smaller businesses get enterprise-quality data work — without inheriting enterprise dysfunction. Cameroonian-American, based in Charlotte, NC. I write novels when I'm not shipping dashboards.</p>
    <p><a class="badge__link" href="/posts/post-5/">Read: 9 ML Models in a Regulated Bank →</a></p>

    <h2>Services</h2>

    <div class="service-tier">
        <div class="service-tier__header">
            <span class="service-tier__name">The Analytics Audit</span>
            <span class="service-tier__price">$1,500 fixed</span>
        </div>
        <p class="service-tier__scope">1-week turnaround. Data health review, top 5 findings, 3 prioritized recommendations, and 1 before/after visualization. Delivered as a branded PDF report.</p>
        <span class="badge service-tier__time">1 week</span>
        <p class="service-tier__sample"><a class="badge__link" href="mailto:marietambe07@gmail.com?subject=Audit%20sample%20request">Request a sample report →</a></p>
    </div>

    <div class="service-tier service-tier--featured">
        <div class="service-tier__header">
            <span class="service-tier__name">The Data Sprint</span>
            <span class="service-tier__price">Starts at $5,000</span>
        </div>
        <p class="service-tier__scope">2-week focused build. One deliverable: a dashboard + pipeline, a data validation tool, a churn model + playbook, or a Streamlit deployment. Fixed scope, fixed price. Training session included.</p>
        <span class="badge service-tier__time">2 weeks</span>
    </div>

    <div class="service-tier">
        <div class="service-tier__header">
            <span class="service-tier__name">Monthly Retainer</span>
            <span class="service-tier__price">Starts at $1,500/mo</span>
        </div>
        <p class="service-tier__scope">10–15 hours of async support per month. Model monitoring, dashboard updates, ad-hoc questions, small enhancements. Async-only, 24–48 hr response.</p>
        <span class="badge service-tier__time">Ongoing</span>
    </div>

    <div class="agency-block">
        <p class="agency-block__title">For Agencies</p>
        <p class="agency-block__body">Agency subcontract rates available on request. Weekly invoicing, async-only, white-label friendly. I'm not building my own book — your client relationship stays yours.</p>
        <a class="badge__link" href="mailto:marietambe07@gmail.com?subject=Agency%20subcontract">Email to discuss →</a>
    </div>

    <h2>Projects</h2>
    <ul role="list" class="link-card-grid">
        {allProjects.map((card) => (
            <Card
                url={`/projects/${card.id}/`}
                image={card.data.image.url}
                title={card.data.title}
                body={card.data.description}
            />
        ))}
    </ul>
    <div class="center" style="margin-top:1rem;">
        <a href="/works/">
            <button class="btn">View all projects</button>
        </a>
    </div>

    <h2 id="contact">Contact</h2>
    <p>I reply within 24 hours. Based in Charlotte, NC — available worldwide, async-first.</p>
    <ul class="contact-list">
        <li>
            <span class="badge badge--item">LinkedIn</span>
            <a class="badge__link" href="https://www.linkedin.com/in/jacobyne-marie-tambe/" target="_blank">linkedin.com/in/jacobyne-marie-tambe</a>
        </li>
        <li>
            <span class="badge badge--item">Email</span>
            <a class="badge__link" href="mailto:marietambe07@gmail.com?subject=Project%20inquiry">marietambe07@gmail.com</a>
        </li>
    </ul>
    <p class="contact-hint">Subject line: <em>Project inquiry</em>, <em>Agency subcontract</em>, or <em>Data analyst role</em></p>
</Layout>
