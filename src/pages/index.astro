---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Card from '../components/Card.astro';
const pageTitle = "Jacobyne Tambe";
const description = "From raw data to client-ready pipelines. Production ML, Streamlit tooling, and data pipelines. Based in Charlotte, NC.";
const allProjects = await getCollection("projects");
---
<Layout pageTitle={pageTitle} description={description}>

    <div class="hero__layout">
        <!-- Add headshot.jpg to public/images/ to show this -->
        <img
            src="/images/headshot.jpg"
            alt="Jacobyne Tambe"
            class="headshot"
            width="96"
            height="96"
            style="display:none"
        />
        <div class="hero__text">
            <h1>Jacobyne Tambe</h1>
            <p class="hero__tagline">From raw data to client-ready pipelines.</p>
        </div>
    </div>

    <!-- subhead -->
    <p class="hero__promise">White-label Analytics Engineer specializing in production data automation, custom data apps, and enterprise-grade documentation.</p>

    <!-- Credibility anchor -->
    <div class="credibility-anchor">
        <span class="badge">Bank of America</span>
        <span class="credibility-anchor__text">9 ML models in production · Regulated enterprise · Charlotte, NC</span>
    </div>

    <div class="center hero__cta">
        <a href="#projects">
            <button class="btn">See the work →</button>
        </a>
    </div>

    <!-- PHASE4: Uncomment for Phase 4 launch
    <p class="center hero__loom"><a class="badge__link" href="https://loom.com/share/YOUR_LOOM_ID">▶ Watch: 60-sec intro — what I build and how fast I ship</a></p>
    -->

    <h2>About</h2>
    <p>I'm an analytics engineer based in Charlotte, NC. For the last two-plus years I've been building production ML systems, data pipelines, and operational tooling inside one of the most regulated data environments in financial services. I shipped nine data models and coordinated hundreds of change requests.</p>
    <p>My stack: Python, scikit-learn, XGBoost, SHAP, Streamlit, Pandas, SQL, GitHub Actions, Excel.</p>
    <p>I build end-to-end pipelines that slip seamlessly into your agency's existing client workflows. From ingestion to deployment, I write production-grade code that non-technical account managers can interpret and act on. I document every asset natively so your internal team can step in at any time without a technical bottleneck.</p>

    <!-- START SERVICES SECTION -->
    <section id="services">

        <h2>Services &amp; Engagement Models</h2>
        <p class="hero__promise">Tailored for boutique consulting firms, marketing agencies, and fractional CMOs. No overhead, zero management drag, and complete async reliability.</p>

        <!-- SERVICE 1 -->
        <div class="service-tier">
            <div class="service-tier__header">
                <h3 class="service-tier__name">Analytics Audit</h3>
                <span class="service-tier__price">$1,500 Fixed Fee</span>
            </div>
            <p class="service-tier__scope"><em>Quickly diagnose broken data flows and unlock immediate optimization strategies.</em></p>
            <ul>
                <li><strong>Timeline:</strong> 1-Week Turnaround.</li>
                <li><strong>What You Get:</strong> Complete data infrastructure health review identifying top 5 data hygiene vulnerabilities, 3 actionable performance fixes, and before/after schema visualizations.</li>
                <li><strong>Agency Value:</strong> Delivered as a fully <strong>white-labeled PDF report</strong> so your account managers can brand it and pass it directly to your client.</li>
            </ul>
        </div>

        <!-- SERVICE 2 -->
        <div class="service-tier">
            <div class="service-tier__header">
                <h3 class="service-tier__name">Data Sprint</h3>
                <span class="service-tier__price">From $5,000 Project Rate</span>
            </div>
            <p class="service-tier__scope"><em>Accelerate your client delivery timelines with dedicated, high-impact engineering execution.</em></p>
            <ul>
                <li><strong>Timeline:</strong> 2-Week Sprint (Includes a bundled training and transition session).</li>
                <li><strong>What You Get:</strong> A focused infrastructure build for a production data pipeline, complex reporting dashboard, or a custom internal data tool (Streamlit).</li>
                <li><strong>Agency Value:</strong> Eliminates hourly billing drift. <em>Note: The 2-week timeline strictly commences once all necessary data environment credentials and schemas are provisioned and verified.</em></li>
            </ul>
        </div>

        <!-- SERVICE 3 -->
        <div class="service-tier service-tier--featured" style="position: relative;">
            <span class="badge" style="position: absolute; top: -0.8rem; right: 1rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;">Max 3 Active Clients</span>
            <div class="service-tier__header">
                <h3 class="service-tier__name">Monthly Retainer</h3>
                <span class="service-tier__price">From $1,500 / mo</span>
            </div>
            <p class="service-tier__scope"><em>On-demand asynchronous analytics engineering to absorb your team's ongoing data ops task load.</em></p>
            <ul>
                <li><strong>Capacity:</strong> 10–15 technical hours allocated per month.</li>
                <li><strong>What You Get:</strong> Ongoing asynchronous data support for iterative feature builds, QA script monitoring, pipeline cleaning updates, and rapid bug triage.</li>
                <li><strong>Agency Value:</strong> 24–48 hour response windows via Slack or ClickUp. Secures continuous engineering depth on a predictable, fractional budget.</li>
            </ul>
        </div>

        <!-- SERVICE 4 -->
        <div class="service-tier">
            <div class="service-tier__header">
                <h3 class="service-tier__name">Agency Subcontracting</h3>
                <span class="service-tier__price">$85 – $110 / hr</span>
            </div>
            <p class="service-tier__scope"><em>Seamlessly inject an enterprise-grade developer into your live client project delivery workflows.</em></p>
            <ul>
                <li><strong>Availability:</strong> 10–20 hours per week (Billed via clean weekly timesheets + invoicing).</li>
                <li><strong>What You Get:</strong> Direct, unbranded positioning inside your team. I handle the heavy backend Python/SQL engineering and custom data product deployment.</li>
                <li><strong>Agency Value:</strong> 100% white-label, async-first infrastructure execution. I write production-grade code natively documented with clean dbt configurations and GitHub tracking so your internal team can step in and own it instantly.</li>
            </ul>
        </div>

    </section>
    <!-- END SERVICES SECTION -->

    
    <h2 id="projects">Projects</h2>
    <ul role="list" class="link-card-grid">
        {allProjects.map((card) => (
            <Card
                url={`/projects/${card.id}/`}
                image={card.data.image.url}
                title={card.data.title}
                body={card.data.description}
            />
        ))}
    </ul>
    <div class="center" style="margin-top:1rem;">
        <a href="/works/">
            <button class="btn">View all projects</button>
        </a>
    </div>

    <h2 id="contact">Contact</h2>
    <p>Based in Charlotte, NC. Available worldwide, async-first. I reply within 24 hours.</p>
    <ul class="contact-list">
        <li>
            <span class="badge badge--item">LinkedIn</span>
            <a class="badge__link" href="https://www.linkedin.com/in/jacobyne-marie-tambe/" target="_blank">linkedin.com/in/jacobyne-marie-tambe</a>
        </li>
        <li>
            <span class="badge badge--item">Email</span>
            <a class="badge__link" href="mailto:jacobynemarietambe@gmail.com">jacobynemarietambe@gmail.com</a>
        </li>
        <!-- PHASE4: Add intake form and book-a-call link here
        <li>
            <span class="badge badge--item">Book a call</span>
            <a class="badge__link" href="https://calendly.com/YOUR_HANDLE" target="_blank">Schedule a 20-min intro call</a>
        </li>
        -->
    </ul>
</Layout>
